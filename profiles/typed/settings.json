{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-readseek@0.5.18",
    "npm:@ff-labs/pi-fff",
    "npm:@monotykamary/pi-retry",
    "npm:pi-lens@3.8.73",
    "npm:pi-caveman@1.0.7",
    "npm:pi-token-speed",
    "npm:pi-fast-resume",
    "npm:pi-diff-review@0.1.26",
    "npm:@beyona/pi-zai-usage@0.4.0",
    {"source": "npm:pine-of-glass@0.6.2", "extensions": ["extensions/pi-traceline/**"]},
    "npm:pi-my-setup",
    "npm:pi-markdown-preview"
  ],
  "readseek": {"replacedTools": ["read", "edit", "write"], "imageMode": "auto", "syntaxValidation": "warn", "timeoutMs": 120000},
  "hideThinkingBlock": true,
  "theme": "dark",
  "compaction": {"enabled": true, "reserveTokens": 12500, "keepRecentTokens": 24000},
  "thresholds": {"checkpoint": 98, "standard": 99, "hard": 100},
  "cooldownMs": 120000,
  "experimentalToolOutputPruning": false,
  "toolOutputPruningMode": "off",
  "toolOutputPruneStrategy": "stub",
  "enableSkillCommands": true
}
