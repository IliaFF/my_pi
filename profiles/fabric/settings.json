{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@monotykamary/pi-retry",
    {"source": "npm:pi-fabric@0.28.13", "skills": ["skills/fabric-exec/**"]},
    "npm:pi-caveman@1.0.7",
    "npm:pi-token-speed",
    "npm:pi-fast-resume",
    "npm:@beyona/pi-zai-usage@0.4.0",
    {"source": "npm:pine-of-glass@0.6.2", "extensions": ["extensions/pi-traceline/**"]}
  ],
  "hideThinkingBlock": true,
  "theme": "dark",
  "compaction": {"enabled": true, "reserveTokens": 12500, "keepRecentTokens": 24000},
  "thresholds": {"checkpoint": 98, "standard": 99, "hard": 100},
  "cooldownMs": 120000,
  "experimentalToolOutputPruning": false,
  "toolOutputPruningMode": "off",
  "toolOutputPruneStrategy": "stub",
  "enableSkillCommands": true
}
