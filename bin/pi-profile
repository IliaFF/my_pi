#!/usr/bin/env bash
set -euo pipefail

profile="${1:-default}"
if [[ $# -gt 0 ]]; then shift; fi
profile_root="${PI_PROFILE_ROOT:-$HOME/.pi/profiles}"

case "$profile" in
  default)
    exec pi "$@"
    ;;
  research)
    export PI_CODING_AGENT_DIR="$profile_root/research"
    exec pi "$@"
    ;;
  typed)
    export PI_CODING_AGENT_DIR="$profile_root/typed"
    export PI_LENS_NO_CONTEXT_INJECTION=1
    exec pi --no-lens-context --no-autoformat --no-autofix --no-tests \
      --exclude-tools ast_grep_search,ast_grep_replace,ast_grep_outline,ast_grep_dump,lsp_navigation,lens_diagnostic_mark "$@"
    ;;
  fabric)
    export PI_CODING_AGENT_DIR="$profile_root/fabric"
    exec pi "$@"
    ;;
  tmux)
    export PI_CODING_AGENT_DIR="$profile_root/tmux"
    exec pi "$@"
    ;;
  *)
    echo "usage: pi-profile {default|research|typed|fabric|tmux} [pi args...]" >&2
    exit 2
    ;;
esac
