+
+function directoryCommand(shell: RemoteShell, cwd: string, home: string): string {
+  if (shell === "posix") return cwd === FALLBACK_REMOTE_CWD ? "cd -- ~" : `cd -- ${quote(cwd)}`;
+  const target = cwd === FALLBACK_REMOTE_CWD ? home : cwd;
+  // shortcut: cmd paths with shell metacharacters are rejected, add tested escaping before supporting them.
+  if (!target || /[\x00-\x1f\x7f"%!^&|<>()]/.test(target)) throw new Error("Unsupported Windows cwd: shell metacharacters are not allowed");
+  return `cd /d "${target}"`;
+}
+
+function commandInDirectory(state: RemoteState, cwd: string, command: string): string {
+  return `${directoryCommand(state.shell, cwd, state.home)} && ${command}`;
+}
+
+async function detectRemoteShell(client: SshClient): Promise<{ shell: RemoteShell; home: string }> {
+  // Probe the default shell itself: invoking cmd.exe would also succeed from PowerShell.
+  const windows = (await execRemote(client, "echo __PI_REMOTE_CMD__%OS%&& cd", true, 5, "probe")).toString().trim();
+  const match = windows.match(/^__PI_REMOTE_CMD__Windows_NT\r?\n([A-Za-z]:\\[^\r\n]*)$/);
+  if (match) {
+    directoryCommand("cmd", match[1]!, match[1]!);
+    return { shell: "cmd", home: match[1]! };
+  }
+  const posix = (await execRemote(client, "printf '__PI_REMOTE_POSIX__\\n' && pwd -P", true, 5, "probe")).toString().trim();
