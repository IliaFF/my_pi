+function withRemoteTimeout(command: string, timeoutSeconds: number, shell: RemoteShell | "probe" = "posix"): string {
+  return shell === "posix" ? `timeout --signal=TERM --kill-after=5s ${timeoutSeconds}s bash -lc ${quote(command)}` : command;
