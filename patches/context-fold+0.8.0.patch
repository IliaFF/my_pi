+/**
+ * Fold thresholds, ladder step and budget are measured against the EFFECTIVE window our build runs:
+ * auto-compaction caps at 170k, so a larger provider window would keep masking asleep until long
+ * past the point where compaction replaces the history anyway.
+ */
+const EFFECTIVE_FOLD_WINDOW = 170_000;
+
+function foldWindow(contextWindow: number | null, fallback: number): number {
+	const window = contextWindow ?? fallback;
+	return window > 0 ? Math.min(window, EFFECTIVE_FOLD_WINDOW) : window;
+}
