{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "copyFormatting": "none",
  "copyOnSelect": false,
  "keybindings": [
    { "id": "Terminal.CopyToClipboard", "keys": "ctrl+c" },
    { "id": "Terminal.FindText", "keys": "ctrl+shift+f" },
    { "id": "Terminal.PasteFromClipboard", "keys": "ctrl+v" },
    { "id": "Terminal.DuplicatePaneAuto", "keys": "alt+shift+d" }
  ],
  "profiles": {
    "defaults": {
      "backgroundImage": "%USERPROFILE%\\Pictures\\Terminal\\catppuccin-mocha-blur.jpg",
      "backgroundImageAlignment": "center",
      "backgroundImageOpacity": 0.18,
      "backgroundImageStretchMode": "uniformToFill",
      "colorScheme": "Catppuccin Mocha",
      "font": { "face": "JetBrainsMono Nerd Font" },
      "opacity": 90,
      "useAcrylic": true
    }
  },
  "schemes": [
    {
      "name": "Catppuccin Mocha",
      "background": "#1E1E2E",
      "foreground": "#F2F3FF",
      "cursorColor": "#F5E0DC",
      "selectionBackground": "#585B70",
      "black": "#45475A",
      "red": "#F38BA8",
      "green": "#A6E3A1",
      "yellow": "#F9E2AF",
      "blue": "#89B4FA",
      "purple": "#F5C2E7",
      "cyan": "#94E2D5",
      "white": "#E8EBFF",
      "brightBlack": "#585B70",
      "brightRed": "#F38BA8",
      "brightGreen": "#A6E3A1",
      "brightYellow": "#F9E2AF",
      "brightBlue": "#89B4FA",
      "brightPurple": "#F5C2E7",
      "brightCyan": "#94E2D5",
      "brightWhite": "#FFFFFF"
    }
  ]
}
