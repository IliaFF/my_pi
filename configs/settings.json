{
  "lastChangelogVersion": "0.99.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@monotykamary/pi-retry",
    "npm:@spences10/pi-context",
    "npm:pi-web-access",
    "npm:@llblab/pi-telegram",
    "npm:pi-caveman",
    "npm:@dietrichgebert/ponytail",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@tunnckocore/pi-gpt-fast-mode",
    "npm:pi-token-speed",
    "npm:pi-fast-resume",
    "npm:pi-diff-review",
    "npm:@beyona/pi-zai-usage",
    {
      "source": "npm:pine-of-glass",
      "extensions": [
        "extensions/pi-contextimate/**",
        "extensions/pi-traceline/**",
        "extensions/pi-cachemire/**"
      ]
    },
    "npm:pi-my-setup",
    "npm:pi-markdown-preview",
    "npm:context-fold"
  ],
  "readseek": {
    "replacedTools": [
      "read",
      "edit",
      "write"
    ],
    "imageMode": "auto",
    "syntaxValidation": "warn",
    "timeoutMs": 120000
  },
  "hideThinkingBlock": true,
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 12500,
    "keepRecentTokens": 12000
  },
  "thresholds": {
    "checkpoint": 98,
    "standard": 99,
    "hard": 100
  },
  "cooldownMs": 120000,
  "experimentalToolOutputPruning": false,
  "toolOutputPruningMode": "off",
  "toolOutputPruneStrategy": "stub",
  "enableSkillCommands": true
}
