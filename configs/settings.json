{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@monotykamary/pi-retry",
    "npm:@spences10/pi-context@0.1.16",
    "npm:pi-web-access",
    "npm:@llblab/pi-telegram@0.42.2",
    "npm:pi-caveman@1.0.8",
    "npm:@dietrichgebert/ponytail@4.9.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:@tunnckocore/pi-gpt-fast-mode@0.4.0",
    "npm:pi-token-speed",
    "npm:pi-fast-resume",
    "npm:pi-diff-review@0.1.26",
    "npm:@beyona/pi-zai-usage@1.1.0",
    {
      "source": "npm:pine-of-glass@0.10.2",
      "extensions": [
        "extensions/pi-contextimate/**",
        "extensions/pi-traceline/**",
        "extensions/pi-cachemire/**"
      ]
