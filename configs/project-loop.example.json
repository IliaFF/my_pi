{
  "version": 1,
  "context": {
    "files": [
      "README.md",
      "TODO.md"
    ],
    "maxChars": 5000
  },
  "validation": {
    "targeted": {
      "unit": {
        "command": "npm test -- --runInBand",
        "timeoutMs": 120000
      }
    },
    "finish": [
      {
        "name": "verify",
        "command": "./scripts/verify.sh",
        "timeoutMs": 180000
      }
    ]
  }
}
