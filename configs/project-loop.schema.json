{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IliaFF/my_pi/blob/main/configs/project-loop.schema.json",
  "title": "Pi project loop profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "maxChars": { "type": "integer", "minimum": 1500, "maximum": 5000 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targeted": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/commandOrString"
          }
        },
        "finish": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "allOf": [
                  { "$ref": "#/$defs/command" },
                  {
                    "type": "object",
                    "properties": { "name": { "type": "string", "minLength": 1 } }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "commandOrString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/command" }
      ]
    }
  }
}
