[Unit]
Description=Read-only daily Pi extension research
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/my-pi-extension-watch/vps-extension-watch.py
TimeoutStartSec=1800
KillMode=control-group
MemoryMax=512M
TasksMax=64
LimitFSIZE=64M
NoNewPrivileges=yes
